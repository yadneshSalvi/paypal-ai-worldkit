# Node 22.x. Supply your own isolated sandbox credentials; never use production money.
DATABASE_URL=postgresql://worldkit:CHANGE_ME@127.0.0.1:55432/worldkit
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CRON_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET
WORLDKIT_PUBLIC_URL=http://localhost:4106
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_PROJECT_ISOLATED=worldkit
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Explicitly enable separately scoped, read-only Toolkit observations after qualification.
WORLDKIT_TOOLKIT_READS_ENABLED=0
CHANNEL3_API_BASE_URL=https://api.trychannel3.com
CHANNEL3_API_KEY=
CHANNEL3_WEBHOOK_SECRET=
# Optional previous endpoint secret during a bounded Svix key rotation.
CHANNEL3_WEBHOOK_SECRET_PREVIOUS=
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=max
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
BLOB_READ_WRITE_TOKEN=

# Optional photo-region model overrides; omitted values use the configured planner models.
# OPENAI_VISION_MODEL=gpt-6-astra
# GEMINI_VISION_MODEL=gemini-3.8-flash
# BLOB_READ_WRITE_TOKEN must belong to a private Vercel Blob store.
