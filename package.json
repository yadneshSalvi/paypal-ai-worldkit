{
  "name": "worldkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4106",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4106",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "node --env-file=.env --import tsx --test --test-concurrency=1 tests/*.integration.ts",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "qualify:catalog": "node --env-file=.env --import tsx scripts/qualify-catalog.ts",
    "qualify:models": "node --env-file=.env --import tsx scripts/qualify-models.ts",
    "verify:mcp": "node --env-file=.env --import tsx scripts/verify-mcp.ts",
    "qualify:inventory": "node --env-file=.env --import tsx scripts/qualify-inventory.ts"
  },
  "dependencies": {
    "@channel3/sdk": "4.9.0",
    "@fracture/paypal-core": "file:vendor/fracture-paypal-core-0.2.4.tgz",
    "@google/genai": "3.0.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@paypal/agent-toolkit": "1.11.0",
    "@vercel/blob": "2.9.0",
    "@xyflow/react": "12.12.1",
    "axios": "1.21.1",
    "cheerio": "1.2.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "openai": "7.55.0",
    "pdf-parse": "2.4.5",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "svix": "2.10.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "@vercel/cli-config": "0.3.8",
    "mathjs": "15.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "26.1.0",
    "jsqr": "1.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
